# Google OAuth client for local Supabase Auth (Google Cloud Console → Credentials)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Turns on [auth.external.google] in config.toml, which stays off for clones
# without a client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=true

# The variables the app reads. `pnpm bootstrap` writes .env.local, for local
# development only, with the local values. Production uses the same names,
# stored as the Worker's secrets (wrangler secret put), never in a file here.
# See "Environments" in the README.

# Supabase in Docker: both values come from `supabase status`.
# Production: hosted project → Project Settings → API Keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OpenAI → API keys (used for speech-to-text). Optional in local development:
# without it voice notes are saved but not transcribed.
OPENAI_API_KEY=sk-...

# Emails allowed to use the diary, comma-separated. Sign-ups are also limited by
# the public.allowed_emails table (see supabase/migrations/0004_restrict_signups.sql).
ALLOWED_EMAILS=you@gmail.com

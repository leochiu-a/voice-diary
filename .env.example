# Template for .env.local, which is for local development only:
#   cp .env.example .env.local
# Production uses the same variable names, entered in the host's environment
# variable settings (e.g. Vercel), never in a file here. See "Environments" in
# the README.

# Supabase in Docker: both values come from `supabase status`.
# Production: hosted project → Project Settings → API Keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare R2 → Manage API tokens (Object Read & Write, scoped to the bucket).
# Same bucket and token in local development and production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voice-diary

# OpenAI → API keys (used for speech-to-text). Same key in both environments.
OPENAI_API_KEY=sk-...

# Emails allowed to use the diary, comma-separated. Sign-ups are also limited by
# the public.allowed_emails table (see supabase/migrations/0004_restrict_signups.sql).
ALLOWED_EMAILS=you@gmail.com

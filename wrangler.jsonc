{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice-diary",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-19",
  // Node's APIs (the OpenAI SDK uses them), with the Worker's variables and
  // secrets on process.env, where src/lib/env.ts reads them.
  "compatibility_flags": ["nodejs_compat"],
  // Voice notes' audio (src/lib/r2.ts). `pnpm dev` stands in a local bucket
  // under .wrangler/state, so development needs no Cloudflare account.
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "voice-diary" }],
  // Runs next to the hosted Supabase project in Tokyo, since a page makes
  // several database calls one after another.
  "placement": { "mode": "targeted", "region": "aws:ap-northeast-1" },
  "observability": { "enabled": true },
  // Cloudflare creates the DNS record and certificate on deploy, since
  // leochiu.com's zone is on this account.
  "routes": [{ "pattern": "voice.leochiu.com", "custom_domain": true }],
}
